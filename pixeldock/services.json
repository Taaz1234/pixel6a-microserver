    "log_file": "/data/pixelserver/adguard.log",
    "start_cmd": "su -c 'nohup /data/pixelserver/adguard/AdGuardHome -w /data/pixelserver/adguard -c /data/pixelserver/adguard/AdGuardHome.yaml > /data/pixelserver/adguard.log 2>&1 &'",
    "stop_cmd": "su -c 'pkill -9 AdGuardHome || true'"
  },
